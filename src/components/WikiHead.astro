---
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import { componentEmbed, previewForEntry, previewImageUrl, serializeComponentEmbed } from '../lib/discordPreview.mjs';

const preview = previewForEntry(Astro.locals.starlightRoute.entry);
const imageUrl = previewImageUrl(preview);
const embed = serializeComponentEmbed(componentEmbed(preview, Astro.url.pathname));
---

<Default />
<ClientRouter fallback="swap" />
<script>
  import '../scripts/wikiVideo';
</script>
{[interFont, archivoFont, monoFont, serifFont].map(font => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />)}
<script is:inline>
  if (!window.__wikiMotionStarted && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.__wikiMotionStarted = true;
    document.documentElement.dataset.wikiMotion = 'pending';
    // Fail open if the bundled enhancement cannot load.
    window.setTimeout(() => {
      if (document.documentElement.dataset.wikiMotion === 'pending') delete document.documentElement.dataset.wikiMotion;
    }, 3000);
  }
</script>
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={`${preview.appName}: ${preview.pageTitle}`} />
<meta name="theme-color" content={preview.color} />
<script id="discord:component-embed" type="application/json" set:html={embed} />
